# Server
PORT=5000
NODE_ENV=development

# LLM provider — get your key at https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
# Model — see https://console.groq.com/docs/models for current IDs
GROQ_MODEL=openai/gpt-oss-120b

# Weather data provider — get your key at https://www.weatherapi.com/
WEATHER_API_KEY=your_weatherapi_key_here
